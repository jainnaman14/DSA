                                                  **POINTER ARRAY:-


#include<iostream>
using namespace std;

//POINTERARRAY

int main(){
    int arr[5] = {1,2,3,4,5};
    int *p = arr;
    cout<<p<<endl;
    cout<<*p<<endl;
    cout<<p+2<<endl;
    cout<<*(p+2)<<endl;
    cout<<*(p+4)<<endl;
}




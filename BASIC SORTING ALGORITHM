                                                **BUBBLE SORT:-


#include <iostream>
using namespace std;

//Bubble sort : repeatedly swap the adjacent elements if they are in wrong order.
//Time complexity : O(n^2) in worst and average case and O(n) in best case

int main(){
    int arr[5] = {5, 2, 9, 1, 5};
    for(int i=0 ;i<5;i++){
        for(int j=0 ;j<=5-2;j++){
            if(arr[j]>arr[j+1]){
                swap(arr[j],arr[j+1]);
            }
} 
    }   
    for(int i=0;i<5;i++){
        cout<<arr[i]<<" ";
    }
   
}



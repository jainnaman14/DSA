                                                **BUBBLE SORT:-


#include <iostream>
using namespace std;

//Bubble sort : repeatedly swap the adjacent elements if they are in wrong order.
//Time complexity : O(n^2) in worst and average case and O(n) in best case

int main(){
    int arr[5] = {5, 2, 9, 1, 5};
    for(int i=0 ;i<5;i++){
        for(int j=0 ;j<=5-2;j++){
            if(arr[j]>arr[j+1]){
                swap(arr[j],arr[j+1]);
            }
} 
    }   
    for(int i=0;i<5;i++){
        cout<<arr[i]<<" ";
    }
   
}


                                            **INSERTION SORT:-


#include<iostream>
using namespace std;
//Insertion sort : builds the final sorted array one item at a time by comparing the current element with the previous elements and inserting it into the correct position.
//Time complexity : O(n^2) in worst and average case and O(n) in

int main(){
    int arr[5] ={4,6,2,8,9};
    for(int i=1;i<5;i++){
        for(int j=i;j>0;j--){
        if(arr[j]<arr[j-1])
        swap(arr[j],arr[j-1]);
        }


    }
    for(int i=0;i<5;i++){
        cout<<arr[i]<<" ";
    }
}


                                      **SELECTION SORT:-


#include<iostream>
using namespace std;


int main(){
    int arr[5]={64, 25, 12, 22, 11};
    
    for(int i =0; i<5;i++){
        int min=i;
        for(int j = i+1;j<=5-1;j++){
            if (arr[j]<arr[min]){
                min=j;
                
            }
            
        }
        swap(arr[i],arr[min]);
    }
    for(int i=0; i<5;i++){
        cout<<arr[i]<<" ";
    }
}
